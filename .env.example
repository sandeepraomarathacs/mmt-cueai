APP_ENV=production
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

HOST=127.0.0.1
PORT=8001

# REQUIRED in production — use a long random secret (same as Laravel PYTHON_API_KEY)
API_SECRET_KEY=change-me-to-a-long-random-secret
REQUIRE_API_KEY=true

# Comma-separated browser origins only (Laravel server calls do not need CORS).
# Leave empty to block browser direct calls.
# Example: https://your-web-app.com,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# Per-IP sliding window
RATE_LIMIT_PER_MINUTE=60

# Gemini concurrency
RPM_LIMIT=10

LARAVEL_API_URL=https://your-laravel-domain.com

# ---- Optional live-mic tuning ----
# Keep each answer stable this many seconds (so it does not flicker while you speak)
# ANSWER_HOLD_SEC=18
# SPEECH_RMS_THRESHOLD=0.012
# SPEECH_MIN_RATIO=0.08
# AUDIO_WINDOW_SEC=14
# KEEP_AUDIO_SEC=4
