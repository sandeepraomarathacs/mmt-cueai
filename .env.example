APP_ENV=production
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

HOST=127.0.0.1
PORT=8001

# REQUIRED in production — same as Laravel PYTHON_API_KEY
API_SECRET_KEY=change-me-to-a-long-random-secret
REQUIRE_API_KEY=true

ALLOWED_ORIGINS=
RATE_LIMIT_PER_MINUTE=60
RPM_LIMIT=10
LARAVEL_API_URL=https://your-laravel-domain.com

# Optional mic tuning
# MAX_RECORD_SEC=600
# SPEECH_RMS_THRESHOLD=0.008
# SPEECH_MIN_RATIO=0.05
